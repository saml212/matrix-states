import json
K=32; ch=1.0/K
def kap(a): return (a-ch)/(1-ch)
for cell in ["primary_s0","primary_s1","primary_s2","compB_s0","compB_s1","compB_s2"]:
    d = json.load(open("/home/nvidia/ncr_kscaling/results/k32_wave0_%s_kscaling.json" % cell))
    m = d["matched"]
    assert m["matched"] is True and d["ckpt_step"] == 20000
    def row(reg, h):
        return m[reg]["per_hop"]["h=%d" % h]["acc"]
    tr = [row("P1b", h) for h in (1, 2, 3)]
    top, fix = row("P1b", 48), row("P1b", 36)
