    print("%s: P1b h123=%s kappas=%s | top=%.4f/k=%.4f fix=%.4f/k=%.4f | P0 [%.4f,%.4f]" % (
        cell, ["%.3f" % a for a in tr], ["%.3f" % kap(a) for a in tr],
        top, kap(top), fix, kap(fix), min(p0all), max(p0all)))
