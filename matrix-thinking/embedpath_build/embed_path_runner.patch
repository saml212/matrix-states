 # ---------------------------------------------------------------------------
+# EMBED-PATH INTERVENTION (build agent, 2026-08-21) -- matrix-thinking/
+# NCR_EMBED_PATH_DESIGN.md DRAFT-R1 sec R1.3/R1.4/R1.6 (repo commit db4d385
+# and later; audited attack round matrix-thinking/NCR_EMBED_PATH_ATTACK_R1.md,
+# 591301a, REV-REQUIRED 5F/8M/5m, every finding executed). --close-target=
+# {embed,entity_adapter} cuts aux+ortho's MARGINAL gradient contribution
+# into exactly one named parameter of the full_graft arm, leaving CE's own
+# gradient into that parameter (all three of its routes when target=embed:
+# embedding lookup, tied LM head, and the o-side path -- D-F5/R1.6's own
+# scope statement) completely untouched, and leaving every OTHER parameter
+# (entity_adapter when target=embed; ncr_head; backbone's non-target layers)
+# with the FULL combined gradient, bit-identical to what a plain
+# total_loss.backward() would have produced for that param (D-F3's own
+# two-tier tolerance -- see check_scope_preserved in the verification
+# suite). NEVER built by total_loss - ce_loss subtraction (F2, executed:
+# that form re-walks the entire backbone with a seeded-zero gradient,
+# 14.4-20.0 GPU-h instead of 9.84-13.20) -- built from compute_arm_losses's
+# OWN RETURNED aux_loss/ortho_loss tensors instead (D-F2). The cut happens
+# AFTER clip_grad_norm_ has already run over the FULL combined gradient
+# (D-F5, executed: cutting BEFORE clipping changes the global grad norm,
+# which changes the clip coefficient, which silently rescales EVERY OTHER
+# parameter's effective step as a side effect of the embed/adapter cut --
+# a confound that would have voided the "arms differ only in gradient
+# routing" causal licence the design's own claim depends on).
+# ---------------------------------------------------------------------------
+def _non_ce_term(aux_loss, ortho_loss, aux_read_loss_weight: float, ortho_reg_weight: float):
+    """D-F2: non_ce built DIRECTLY from compute_arm_losses's own returned
+    aux_loss/ortho_loss tensors -- never by total_loss - ce_loss subtraction
+    (F2, executed: the subtraction form re-walks the entire backbone with a
+    gradient that is symbolically exact zero at the Sub node but still
+    costs a full backward pass, and materializes an exact-zero tensor for
+    every backbone param instead of leaving it correctly unreachable/None).
+    Returns None iff both branches are inactive this step (defensive; every
+    launched compE/compE_adapter cell always has aux_read_loss_weight=0.5,
+    ortho_reg_weight=0.1, so this is always a real tensor in practice, but
+    the guard is unconditional per D-F2's own ask, not relied-upon-but-
+    unwritten)."""
+    non_ce = None
+    if aux_loss is not None and aux_read_loss_weight > 0.0:
+        non_ce = aux_read_loss_weight * aux_loss
+    if ortho_loss is not None and ortho_reg_weight > 0.0:
+        term = ortho_reg_weight * ortho_loss
+        non_ce = term if non_ce is None else non_ce + term
+    return non_ce
+
+
+def assemble_closed_grads_(arm: dict, opt: torch.optim.Optimizer, total_loss: torch.Tensor,
+                            ce_loss: torch.Tensor, aux_loss, ortho_loss,
+                            aux_read_loss_weight: float, ortho_reg_weight: float,
+                            close_target: str, max_norm: float = 1.0) -> dict:
+    """--close-target={embed,entity_adapter} (DRAFT-R1 sec R1.6, D-F2+D-F5+
+    D-A2 combined into one function -- see the module-level comment above
+    for why): cuts aux+ortho's marginal gradient contribution into exactly
+    ONE named parameter, AFTER clip_grad_norm_ has already run over the
+    FULL combined gradient (D-F5) -- so every OTHER parameter receives
+    compB's own post-clip gradient, to within D-F3's pinned allclose bound,
+    and the two arms differ in target_w.grad alone. REPLACES
+    total_loss.backward() entirely when close_target is set for this arm --
+    the caller must NOT also call .backward() for it, and must NOT re-run
+    the shared finite/clip_grad_norm_/opt.step() block for this arm (both
+    already happen inside this function, per D-F5's own ordering
+    requirement -- see R1.6's own note on why this restructures the loop).
+
+    BUILD-TIME CORRECTION (disclosed, not silent): DRAFT-R1's own R1.6 text
+    states in its training-loop comment that "clip_grad_norm_ and opt.step()
+    are ALREADY DONE inside assemble_closed_grads_", but the function
+    signature/body given in that same section never receives `opt` and
+    never calls `.step()` -- an internal inconsistency in the design
+    document itself. This build adds `opt` as an explicit parameter and
+    calls `opt.step()` at the end (guarded exactly as the shared block's
+    own `if finite: ... opt.step()` is), so the code matches what the
+    design's own comment already promised the caller. See BUILD_REPORT.md.
+
+    Why the combined side is `total_loss.backward()` itself, not a second
+    re-assembled `grad_ce`: D-F5 requires the clip coefficient to be
+    computed from the SAME global norm compB's own backward() would
+    produce. Calling `total_loss.backward()` for the full combined
+    gradient and taking ONE separate targeted `torch.autograd.grad(non_ce,
+    [target_w], retain_graph=True)` call BEFORE it (order matters for
+    graph retention, not for values) gets `grad_rest[target]` alone without
+    ever re-deriving `grad_ce` via a second `autograd.grad(ce_loss, ...)`
+    call -- so D-F2's allow_unused/None-set assertion only needs to check
+    ONE parameter (the target), not every param in all_params (R1.6's own
+    simplification).
+
+    Returns {"cut_active": bool, "stepped": bool, "conduit_ratio": float,
+    "clip_coef": float, "target": str} -- conduit_ratio and clip_coef are
+    the D-A2 has-teeth diagnostics (see assert_conduit_has_teeth); "stepped"
+    is a SECOND build-time addition (not present in DRAFT-R1's own R1.6
+    text at all): both of R1.6's own early-return branches
+    ("non_ce is None" / "grad_rest_target is None" -- both expected to be
+    dead code in every launched compE/compE_adapter cell, since
+    aux_read_loss_weight=0.5 and ortho_reg_weight=0.1 are always > 0 and
+    embed/entity_adapter are both structurally on the conduit -- see
+    _non_ce_term's own docstring) called total_loss.backward() and
+    returned WITHOUT ever running the finite check, clip_grad_norm_, or
+    opt.step() -- silently dropping that training step's parameter update
+    entirely, with no signal to the caller. Fixed here: every path now
+    finite-checks, clips, and steps identically to the shared block's own
+    `if finite: clip; opt.step() else: n_skipped += 1` pattern, and reports
+    whether it actually stepped so the caller's n_skipped bookkeeping stays
+    accurate even on this (expected-unreachable) fallback path. See
+    BUILD_REPORT.md."""
+    target_w = {"embed": arm["backbone"].embed.weight,
+                "entity_adapter": arm["integ"].entity_adapter.weight}[close_target]
+    all_params = [p for p in (list(arm["backbone"].parameters()) +
+                               list(arm["ncr"].parameters()) +
+                               list(arm["integ"].parameters())) if p.requires_grad]
+
+    def _finite_clip_step() -> bool:
+        finite = all(p.grad is None or torch.isfinite(p.grad).all() for p in all_params)
+        if finite:
+            torch.nn.utils.clip_grad_norm_(all_params, max_norm)
+            opt.step()
+        return finite
+
+    non_ce = _non_ce_term(aux_loss, ortho_loss, aux_read_loss_weight, ortho_reg_weight)
+    if non_ce is None:                      # both branches inactive this step -- nothing to cut (dead code in
+                                              # this wave's actual launch config, guarded anyway per D-F2)
+        total_loss.backward()
+        stepped = _finite_clip_step()
+        return {"cut_active": False, "stepped": stepped, "conduit_ratio": 0.0, "clip_coef": 1.0, "target": close_target}
+
+    grad_rest_target = torch.autograd.grad(non_ce, [target_w], retain_graph=True, allow_unused=True)[0]
+    total_loss.backward()                   # populates the FULL combined .grad for every param, incl. target_w
+
+    # D-F2 None-set assertion, narrowed to the one param that matters here (R1.6):
+    # allow_unused=True is genuinely load-bearing for this call (target_w becoming
+    # unreachable from non_ce would be a real, not spurious, structural fact) -- if
+    # it fires, the flag would be closing an already-empty door; report as inert
+    # rather than silently proceeding as if a real cut happened. Also dead code in
+    # this wave's actual config (embed and entity_adapter are both structurally on
+    # the conduit -- §2.1/§4 of the design), guarded anyway.
+    if grad_rest_target is None:
+        stepped = _finite_clip_step()
+        return {"cut_active": False, "stepped": stepped, "conduit_ratio": 0.0, "clip_coef": 1.0, "target": close_target}
+
+    combined_before_clip = target_w.grad.detach().clone()
+    grad_ce_target = combined_before_clip - grad_rest_target      # derived, NOT a second ce_loss.backward() call
+                                                                     # (D-F3: this is the TOLERANCE tier, not exact --
+                                                                     # float non-associativity at the shared o_raw/Z
+                                                                     # node means this is not bit-identical to a
+                                                                     # hypothetical standalone ce_loss.backward())
+    conduit_ratio = (grad_rest_target.norm() / grad_ce_target.norm().clamp_min(1e-12)).item()   # D-A2(i)
+
+    finite = all(p.grad is None or torch.isfinite(p.grad).all() for p in all_params)
+    if not finite:
+        return {"cut_active": False, "stepped": False, "conduit_ratio": conduit_ratio,
+                "clip_coef": float("nan"), "target": close_target}
+
+    torch.nn.utils.clip_grad_norm_(all_params, max_norm)   # scales EVERY param's .grad in place, incl. target_w's
+                                                              # FULL combined grad -- same clip coefficient compB
+                                                              # itself gets for this batch (D-F5)
+    combined_after_clip = target_w.grad.detach().clone()
+    clip_coef = (combined_after_clip.norm() / combined_before_clip.norm().clamp_min(1e-12)).item()   # the EXACT
+                                                              # applied ratio, not PyTorch's internal formula
+                                                              # re-derived by hand
+
+    target_w.grad.sub_(grad_rest_target * clip_coef)     # remove aux+ortho's (equally clipped) share -- AFTER clipping
+    grad_ce_target_clipped = grad_ce_target * clip_coef
+    # D-A2(ii): per-step identity check, TOLERANCE tier per D-F3 (embed AND entity_adapter
+    # both sit on the shared o_raw/Z node reached by both CE and aux/ortho -- neither is
+    # exact-tier; see check_scope_preserved in the verification suite for the full two-tier
+    # split, which also covers backbone-block/read_injector params on the EXACT tier).
+    assert torch.allclose(target_w.grad, grad_ce_target_clipped, rtol=1e-5, atol=1e-6), (
+        f"close_target={close_target}: post-cut grad does not match CE's own (clipped) share within tolerance")
+    opt.step()      # build-time correction above: opt threaded in explicitly, called here per D-F5's own ordering
+    return {"cut_active": True, "stepped": True, "conduit_ratio": conduit_ratio, "clip_coef": clip_coef, "target": close_target}
+
+
+def assert_conduit_has_teeth(grad_diag: dict, step: int, min_ratio: float) -> None:
+    """D-A2(i), R1.6: min_ratio is PINNED FROM A BUILD-TIME SMOKE MEASUREMENT
+    (never guessed -- CLAUDE.md's own 'measured, not just estimated' rule),
+    the mean conduit_ratio over the first ~50 real training steps of a
+    full_graft cell with the flag active, times a safety margin -- NOT an
+    absolute floor (DRAFT-R0's original 'min_conduit_norm=1.0' could not
+    detect the vacuous-pass mode the attack found: a large CE norm can
+    swamp a genuinely small aux+ortho norm and still clear an absolute
+    floor). Called every step close_target is active; returns without
+    asserting (not `assert True`) on a 'cut_active=False' step, so this
+    cannot reproduce DRAFT-R0's m2 contradiction (an unconditional
+    assert-cut_active immediately after a branch that can legitimately
+    return cut_active=False)."""
+    if not grad_diag["cut_active"]:
+        return
+    assert grad_diag["conduit_ratio"] > min_ratio, (
+        f"step {step}: HAS-TEETH FAILED -- conduit_ratio={grad_diag['conduit_ratio']:.4f} "
+        f"<= pinned min_ratio={min_ratio:.4f}; the flag may be closing an "
+        f"already-negligible path")
+
+
